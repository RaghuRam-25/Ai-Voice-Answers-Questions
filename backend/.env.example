# ─────────────────────────────────────────────────────────────
# AI Assistant — backend environment
# Copy to `.env` and fill in real values. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5001
# Allowed browser origins (comma-separated). Set your Vercel URL in production on Render:
# Example: https://your-project.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002
FRONTEND_URL=https://your-project.vercel.app

# ── AI provider ─────────────────────────────────────────────
# openai | gemini | custom | local
AI_PROVIDER=gemini

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Custom / self hosted OpenAI-compatible gateway
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ── Assistant behaviour ─────────────────────────────────────
# Hard cap for a single user message
MAX_MESSAGE_LENGTH=4000
# Number of previous turns sent to the model as context
CONVERSATION_HISTORY_TURNS=8
# TTL for a pending destructive-action confirmation
CONFIRMATION_TTL_MS=60000

# ── Storage ────────────────────────────────────────────────
# Directory used for the JSON document store (conversations, notes, reminders)
DATA_DIR=./data